# Use the pooled connection string from your Neon development branch at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_DEV_BRANCH-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI migrations require the direct connection string for that same branch.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR_DEV_BRANCH.REGION.aws.neon.tech/neondb?sslmode=require"
